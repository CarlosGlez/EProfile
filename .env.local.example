# Copia este archivo a .env.local y completa con los valores de tu
# proyecto de Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para el servidor. NUNCA la expongas al navegador ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública donde correrá la plataforma (usada para el QR y los enlaces).
# En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
